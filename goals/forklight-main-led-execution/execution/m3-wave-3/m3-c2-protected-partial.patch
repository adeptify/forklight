+      },
+      paths: {} as TaskRecord["paths"],
+      sessionId: `s-${id}`,
+      createdAt: now,
+      updatedAt: now,
+      startedAt: now,
+      finishedAt: now,
+    } as TaskRecord;
+    store.createTask(record);
+    store.createAttempt({
+      id: `${id}-1`, taskId: id, ordinal: 1, status,
+      sessionId: record.sessionId, rawLogPath: "/log", startedAt: now, finishedAt: now,
+    });
