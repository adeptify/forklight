+    };
+    assert.deepEqual(after, before);
+    const json = JSON.stringify(result);
+    assert.doesNotMatch(json, /api[_-]?key/i);
+    assert.doesNotMatch(json, /endpoint/i);
+    assert.doesNotMatch(json, /keychain/i);
+    assert.doesNotMatch(json, /\/Users\//);
