+function parseDeliveryInteger(raw: string, label: string, allowZero: boolean): number {
+  if (!(allowZero ? /^(?:0|[1-9]\d*)$/ : /^[1-9]\d*$/).test(raw)) {
+    throw new Error(`${label} must be a ${allowZero ? "nonnegative" : "positive"} integer`);
+  }
