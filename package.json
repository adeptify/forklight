{
  "name": "forklight",
  "version": "0.2.0",
  "private": true,
  "description": "Local-first orchestration and observability for accountable coding workers.",
  "type": "module",
  "bin": {
    "forklight": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --disable-warning=ExperimentalWarning --import tsx src/cli.ts",
    "test": "node --disable-warning=ExperimentalWarning --test --import tsx tests/*.test.ts",
    "check": "npm run build && npm test"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "yaml": "^2.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@hono/node-server": "2.0.11"
  }
}
